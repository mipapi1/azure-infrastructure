# Copy to az-aks/gitops/clusters/<cluster>/optional.yaml, keep the components you want and list
# the file in that cluster's kustomization.yaml.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: optional-image-verification
  namespace: flux-system
spec:
  dependsOn:
    - name: infra-configs
  interval: 30m
  retryInterval: 2m
  timeout: 10m
  sourceRef:
    kind: GitRepository
    name: cluster-config
  path: ./az-aks/gitops/optional/image-verification
  prune: true
  postBuild:
    substituteFrom:
      - kind: ConfigMap
        name: cluster-settings
