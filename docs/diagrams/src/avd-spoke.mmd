  user((Users)) -->|AVD gateway| ws[Workspace]
  ws --> dag[Desktop app group]
  ws --> rag[RemoteApp groups]
  dag --> hp[Host pool<br/>pooled, BreadthFirst]
  rag --> hp
  sp[Scaling plan] --> hp
  subgraph spoke["AVD spoke VNet"]
    subgraph hosts["snet-session-hosts"]
