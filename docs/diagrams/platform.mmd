%% Source of docs/diagrams/platform.{light,dark}.svg (hand-drawn Mermaid, one SVG per theme).
%% Colour classes: gov, sec, net, data, obs, ci, muted on nodes; z-<class> on subgraphs.
%% The classDefs and the hand-drawn look are added at render time, so this file holds only structure.
flowchart TB
  subgraph mg["Management groups (governance)"]
    direction LR
    root[alz] --- plat[alz-platform] --- lz[alz-landingzones<br/>allowed locations, security benchmark]
  end
  subgraph hub["Hub: rg-hub, vnet-hub 10.0.0.0/22"]
    afw[Azure Firewall<br/>egress + DNS proxy<br/>IP group per spoke subnet]
    bas[Bastion]
    kv[(Key Vault<br/>private endpoint)]
    dns[(Private DNS zones<br/>vault, file/blob, acr,<br/>postgres, gitlab.internal)]
    law[(Log Analytics<br/>+ Sentinel)]
  end
  subgraph aib["Image Builder spoke: rg-image-builder, 10.4.0.0/24"]
    it[Image Builder<br/>build VM + container subnets]
    gal[(Compute Gallery<br/>win11-avd, ubuntu-2404-stig)]
  end
  subgraph jb["Jumpbox spoke: rg-jumpbox, 10.3.0.0/24"]
    vm[Ubuntu jumpbox<br/>STIG-hardened image]
  end
  subgraph avd["AVD spoke: rg-avd, 10.1.0.0/23"]
    hosts[Session hosts<br/>Entra-joined] --- fsl[(FSLogix profiles<br/>Azure Files or blob)]
    hp[Host pool, desktop,<br/>workspace] --- hosts
  end
  subgraph aks["AKS spoke: rg-aks, 10.2.0.0/22"]
    cluster[aks-platform<br/>private, Entra RBAC] --- acr[(Container registry<br/>private endpoint)]
    cluster --- app[web-app<br/>internal LB]
    cluster --- gl[GitLab<br/>Helm chart]
    gl --- pg[(PostgreSQL<br/>rg-gitlab, private endpoint)]
  end
  mg ~~~ hub
  afw -->|allow-listed egress| net((Internet))
  afw <-->|peering, 0.0.0.0/0| aib
  afw <-->|peering, 0.0.0.0/0| jb
  afw <-->|peering, 0.0.0.0/0| avd
  afw <-->|peering, 0.0.0.0/0| aks
  afw -.->|logs| law
  it -->|images| gal
  gal -.->|session host image| hosts
  gal -.->|VM image| vm
  bas -.->|SSH| vm
  hosts -.->|80, 22 via firewall| gl

  class root,plat,lz gov
  class afw,bas,kv sec
  class hosts,hp,cluster,app,vm net
  class dns,fsl,acr,pg,gal data
  class law obs
  class it,gl ci
  class net muted
  class mg z-gov
  class hub z-sec
  class avd,aks,jb z-net
  class aib z-ci
