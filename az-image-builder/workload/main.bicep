targetScope = 'subscription'

// Azure Image Builder image templates (Windows and Linux) on an image builder landing zone (../landing-zone).
// One template per entry in images, named <name>-<timestamp>. Builds are started separately.
// Deploy with tools/Deploy-ImageBuilder.ps1, which publishes scripts/ and writes scripts.manifest.json first.
// The build VM's managed identity pulls scripts and installers from blob storage (no keys, no SAS).

import { runScript, inlineStep, getArtifacts, restart, windowsUpdate, runShell, inlineShell, getArtifactsLinux } from 'steps.bicep'
import { landingZoneReference, imageConfig } from '../types.bicep'

////////////////
// parameters //
////////////////

@description('Landing zone to build in: the landingZone output of landing-zone/main.bicep.')
param landingZone landingZoneReference

@description('Images to create templates for.')
@minLength(1)
param images imageConfig[]

@description('Common tags applied to all resources')
param tags object = {}

@description('Used to make template names unique per deployment.')
param baseTime string = utcNow('yyyyMMddHHmmss')

@description('Existing staging resource group for the builds. Empty (default) = Image Builder manages its own.')
param stagingResourceGroupResourceId string = ''

///////////////
// variables //
///////////////

@description('Generated by tools/Publish-ImageBuilderContent.ps1: { version, commit, files: { "<path>": "<SHA256>" } }.')
var manifest = loadJsonContent('scripts.manifest.json')

var lzSubscriptionId = landingZone.?subscriptionId ?? subscription().subscriptionId
var gallerySubscriptionId = landingZone.gallery.?subscriptionId ?? lzSubscriptionId

var blobEndpoint = 'https://${landingZone.storageAccountName}.blob.${environment().suffixes.storage}/'
var scriptsBaseUri = '${blobEndpoint}scripts/${manifest.version}'

var vnetId = resourceId(
  lzSubscriptionId,
  landingZone.resourceGroupName,
  'Microsoft.Network/virtualNetworks',
  landingZone.virtualNetworkName
)

/////////////////////////
// reference resources //
/////////////////////////

resource templateIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2024-11-30' existing = {
  name: landingZone.templateIdentityName
  scope: resourceGroup(lzSubscriptionId, landingZone.resourceGroupName)
}

resource buildVmIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2024-11-30' existing = {
  name: landingZone.buildVmIdentityName
  scope: resourceGroup(lzSubscriptionId, landingZone.resourceGroupName)
}

/////////////
// helpers //
/////////////

func isLinux(image imageConfig) bool => contains(['ubuntu', 'rhel'], image.os)

func family(image imageConfig) string => isLinux(image) ? 'linux' : 'windows'

func hardeningOn(image imageConfig) bool => image.?hardening.?enabled ?? true

func updatesOn(image imageConfig) bool => image.?updates.?enabled ?? true

func profileOf(image imageConfig) string => image.?hardening.?profile ?? 'Restricted'

func browsersOf(image imageConfig) string[] =>
  isLinux(image) ? [] : (image.?hardening.?browsers ?? (image.os == 'ws2022' ? [] : ['edge']))

func stigPackagesOf(image imageConfig) string[] => image.?hardening.?additionalStigPackages ?? []

func popupsOf(image imageConfig) string[] => image.?hardening.?allowedPopups ?? []

func allowedFoldersOf(image imageConfig) string[] => image.?hardening.?appLockerAllowedFolders ?? []

func excludeRulesOf(image imageConfig) string[] => image.?hardening.?excludeRules ?? []

@description('Scripts the image downloads: its OS family folder plus artifacts.json.')
func filesFor(files object, osFamily string) object =>
  toObject(
    filter(items(files), f => startsWith(f.key, '${osFamily}/') || f.key == 'artifacts.json'),
    f => f.key,
    f => f.value
  )

@description('PowerShell single-quoted string literal.')
func psString(value string) string => '\'${replace(value, '\'', '\'\'')}\''

@description('PowerShell array argument: \'a\',\'b\' (or @() when empty).')
func psArray(values string[]) string => empty(values) ? '@()' : join(map(values, v => psString(v)), ',')

@description('Shell single-quoted string literal.')
func shString(value string) string => '\'${replace(value, '\'', '\'"\'"\'')}\''

// '90m' / '48h' -> milliseconds; '' -> 0 (no limit). A bad value fails the deployment.
func sessionLimitMs(limit string) int =>
  empty(limit)
    ? 0
    : int(substring(limit, 0, max(length(limit) - 1, 0))) * int(endsWith(limit, 'h')
        ? '3600000'
        : endsWith(limit, 'm') ? '60000' : 'invalid-session-limit-use-a-number-plus-m-or-h')

func artifactGroupsFor(image imageConfig) string[] =>
  union(
    hardeningOn(image) ? ['${family(image)}-stig'] : [],
    contains(browsersOf(image), 'chrome') ? ['chrome'] : [],
    image.?artifactGroups ?? []
  )

/////////////////////////
// Windows customizers //
/////////////////////////

@description('Inline bootstrap (bootstrap.ps1): downloads and hash-checks the published scripts.')
func windowsBootstrap(files object, baseUri string, clientId string) object => {
  type: 'PowerShell'
  name: 'bootstrapScripts'
  runElevated: true
  runAsSystem: true
  inline: split(
    replace(
      replace(
        replace(
          replace(loadTextContent('bootstrap.ps1'), '\r', ''),
          '__FILES_JSON__',
          replace(string(files), '\'', '\'\'')
        ),
        '__SCRIPTS_BASE_URI__',
        baseUri
      ),
      '__CLIENT_ID__',
      clientId
    ),
    '\n'
  )
}

func windowsUpdateSteps(image imageConfig) object[] =>
  updatesOn(image)
    ? [
        inlineStep('enableMicrosoftUpdate', [
          'New-Item -Path "HKLM:\\Software\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU" -Force | Out-Null'
          'New-ItemProperty -Path "HKLM:\\Software\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU" -Name AllowMUUpdateService -Value 1 -PropertyType DWord -Force | Out-Null'
        ])
        windowsUpdate('windowsUpdate', image.?updates.?updateLimit ?? 20)
        restart('windowsUpdateRestart')
        inlineStep('windowsUpdateStabilization', ['Start-Sleep -Seconds 120'])
      ]
    : []

func windowsSoftwareSteps(image imageConfig) object[] =>
  flatten(map(
    image.?software ?? [],
    s =>
      concat(
        [runScript(s.name, s.script, s.?arguments ?? '')],
        (s.?restartAfter ?? false) ? [restart('${s.name}Restart')] : []
      )
  ))

// Hardening runs after all software (FIPS and AppLocker can break installers). STIG settings that would cut
// Packer's WinRM connection are applied by C:\DeprovisioningScript.ps1 just before sysprep.
func windowsHardeningSteps(image imageConfig) object[] =>
  !hardeningOn(image)
    ? []
    : concat(
        [
          runScript(
            'applyStigPackage',
            'windows/stig/Install-StigPackage.ps1',
            '-Os ${image.os} -Browsers ${psArray(browsersOf(image))} -AdditionalPackages ${psArray(stigPackagesOf(image))}'
          )
          runScript(
            'configureWindows',
            'windows/stig/configureWindows.ps1',
            join(
              concat(
                [
                  '-Os ${image.os}'
                  '-SecurityProfile ${profileOf(image)}'
                  '-DisconnectedSessionLimitMs ${sessionLimitMs(image.?hardening.?disconnectedSessionLimit ?? '')}'
                ],
                empty(image.?hardening.?ntpServer ?? '')
                  ? []
                  : ['-NtpServer ${psString(image.?hardening.?ntpServer ?? '')}'],
                image.?hardening.?legalNotice == null
                  ? []
                  : [
                      '-LegalNoticeCaption ${psString(image.?hardening.?legalNotice.?caption ?? '')}'
                      '-LegalNoticeTextBase64 ${base64(image.?hardening.?legalNotice.?text ?? '')}'
                    ]
              ),
              ' '
            )
          )
        ],
        contains(browsersOf(image), 'edge')
          ? [
              runScript(
                'configureEdge',
                'windows/stig/configureEdge.ps1',
                '-SecurityProfile ${profileOf(image)} -AllowedPopups ${psArray(popupsOf(image))}'
              )
            ]
          : [],
        contains(browsersOf(image), 'chrome')
          ? [
              runScript(
                'configureChrome',
                'windows/stig/configureChrome.ps1',
                '-SecurityProfile ${profileOf(image)} -AllowedPopups ${psArray(popupsOf(image))}'
              )
            ]
          : [],
        (image.?hardening.?appLocker ?? true)
          ? [
              runScript(
                'configureAppLocker',
                'windows/stig/configureAppLocker.ps1',
                '-SecurityProfile ${profileOf(image)} -AdditionalAllowedFolders ${psArray(allowedFoldersOf(image))}${(image.?hardening.?allowAdminsToBrowse ?? false) ? ' -AllowAdminsToBrowse' : ''}'
              )
            ]
          : []
      )

func windowsSteps(image imageConfig, files object, baseUri string, endpoint string, clientId string) object[] =>
  concat(
    [windowsBootstrap(files, baseUri, clientId)],
    windowsUpdateSteps(image),
    [runScript('optimizeWindows', 'windows/common/optimizeWindows.ps1', '')],
    empty(artifactGroupsFor(image))
      ? []
      : [getArtifacts('downloadArtifacts', artifactGroupsFor(image), endpoint, clientId)],
    contains(browsersOf(image), 'chrome') ? [runScript('installChrome', 'windows/common/installChrome.ps1', '')] : [],
    windowsSoftwareSteps(image),
    image.?customizers ?? [],
    windowsHardeningSteps(image),
    [
      restart('finalRestart')
      inlineStep('finalStabilization', ['Start-Sleep -Seconds 120'])
      inlineStep('startSysprepDependencyServices', [
        '$services = "RdAgent","WindowsAzureGuestAgent"; foreach ($svc in $services) { if (Get-Service -Name $svc -ErrorAction SilentlyContinue) { Set-Service -Name $svc -StartupType Automatic; Start-Service -Name $svc -ErrorAction SilentlyContinue } }'
      ])
      // Image Builder runs C:\DeprovisioningScript.ps1 last: withheld STIG settings, cleanup, then sysprep.
      inlineStep('installDeprovisioningScript', [
        'Copy-Item "C:\\ImageBuilder\\windows\\stig\\DeprovisioningScript.ps1" "C:\\DeprovisioningScript.ps1" -Force'
      ])
    ]
  )

///////////////////////
// Linux customizers //
///////////////////////

@description('Inline bootstrap (bootstrap.sh): downloads and hash-checks the published scripts.')
func linuxBootstrap(files object, baseUri string, clientId string) object =>
  inlineShell(
    'bootstrapScripts',
    concat(
      ['cat > /tmp/aib-bootstrap.sh <<\'AIB_BOOTSTRAP_EOF\''],
      split(
        replace(
          replace(
            replace(
              replace(loadTextContent('bootstrap.sh'), '\r', ''),
              '__FILES__',
              join(map(items(files), f => '${f.value} ${f.key}'), '\n')
            ),
            '__SCRIPTS_BASE_URI__',
            baseUri
          ),
          '__CLIENT_ID__',
          clientId
        ),
        '\n'
      ),
      [
        'AIB_BOOTSTRAP_EOF'
        'sudo bash /tmp/aib-bootstrap.sh'
        'rm -f /tmp/aib-bootstrap.sh'
      ]
    )
  )

func linuxSteps(image imageConfig, files object, baseUri string, endpoint string, clientId string) object[] =>
  concat(
    [linuxBootstrap(files, baseUri, clientId)],
    updatesOn(image) ? [runShell('updatePackages', 'linux/common/update-packages.sh', '')] : [],
    empty(artifactGroupsFor(image))
      ? []
      : [getArtifactsLinux('downloadArtifacts', artifactGroupsFor(image), endpoint, clientId)],
    map(image.?software ?? [], s => runShell(s.name, s.script, s.?arguments ?? '')),
    image.?customizers ?? [],
    hardeningOn(image)
      ? [
          runShell(
            'applyStig',
            'linux/stig/harden.sh',
            join(
              concat(
                ['--profile ${shString(image.?hardening.?stigProfile ?? 'stig')}'],
                empty(excludeRulesOf(image)) ? [] : ['--exclude ${shString(join(excludeRulesOf(image), ','))}'],
                (image.?hardening.?scan ?? true) ? [] : ['--no-scan']
              ),
              ' '
            )
          )
        ]
      : [],
    // Image Builder deprovisions (waagent -deprovision+user) after the last customizer.
    [inlineShell('cleanup', ['sudo rm -rf /opt/imagebuilder /var/tmp/imagebuilder'])]
  )

////////////////////////
// module deployments //
////////////////////////

module imageDefinitions 'modules/image-definition.bicep' = [
  for image in images: if (image.definition.?create ?? true) {
    name: 'deploy-${image.name}-definition'
    scope: resourceGroup(gallerySubscriptionId, landingZone.gallery.resourceGroupName)
    params: {
      galleryName: landingZone.gallery.name
      name: image.definition.name
      location: landingZone.location
      tags: tags
      osType: isLinux(image) ? 'Linux' : 'Windows'
      definitionDescription: image.definition.?description ?? ''
      publisher: image.definition.publisher
      offer: image.definition.offer
      sku: image.definition.sku
      securityType: image.definition.?securityType ?? 'TrustedLaunch'
    }
  }
]

module imageTemplates 'modules/image-template.bicep' = [
  for image in images: {
    name: 'deploy-${image.name}-template'
    scope: resourceGroup(lzSubscriptionId, landingZone.resourceGroupName)
    params: {
      name: image.name
      baseTime: baseTime
      location: landingZone.location
      tags: union(tags, image.?tags ?? {})
      vmSize: image.?build.?vmSize ?? 'Standard_D4ds_v5'
      osDiskSizeGB: image.?build.?osDiskSizeGB ?? (isLinux(image) ? 0 : 127)
      buildTimeoutInMinutes: image.?build.?timeoutInMinutes ?? 240
      onError: image.?build.?onError ?? 'cleanup'
      subnetResourceId: '${vnetId}/subnets/${landingZone.buildSubnetName}'
      containerInstanceSubnetResourceId: '${vnetId}/subnets/${landingZone.containerInstanceSubnetName}'
      stagingResourceGroupResourceId: stagingResourceGroupResourceId
      imageSource: image.source
      templateIdentityResourceId: templateIdentity.id
      vmUserAssignedIdentities: [buildVmIdentity.id]
      customizationSteps: isLinux(image)
        ? linuxSteps(
            image,
            filesFor(manifest.files, 'linux'),
            scriptsBaseUri,
            blobEndpoint,
            buildVmIdentity.properties.clientId
          )
        : windowsSteps(
            image,
            filesFor(manifest.files, 'windows'),
            scriptsBaseUri,
            blobEndpoint,
            buildVmIdentity.properties.clientId
          )
      galleryImageDefinitionResourceId: resourceId(
        gallerySubscriptionId,
        landingZone.gallery.resourceGroupName,
        'Microsoft.Compute/galleries/images',
        landingZone.gallery.name,
        image.definition.name
      )
      targetRegions: image.?distribution.?regions ?? [{ name: landingZone.location }]
      excludeFromLatest: image.?distribution.?excludeFromLatest ?? false
      artifactTags: {
        source: image.source.type == 'PlatformImage'
          ? '${image.source.?offer}/${image.source.?sku}'
          : last(split(image.source.?imageVersionId ?? '', '/'))
        os: image.os
        hardening: !hardeningOn(image)
          ? 'none'
          : (isLinux(image) ? (image.?hardening.?stigProfile ?? 'stig') : profileOf(image))
        scriptsVersion: manifest.version
        scriptsCommit: manifest.?commit ?? 'unknown'
      }
    }
    dependsOn: [imageDefinitions]
  }
]

/////////////
// outputs //
/////////////

output resourceGroupName string = landingZone.resourceGroupName
output scriptsVersion string = manifest.version
output imageTemplateNames string[] = [for (image, i) in images: imageTemplates[i].outputs.name]
