metadata name = 'GitLab on AKS'
metadata description = 'Azure side of GitLab on an existing az-aks cluster: PostgreSQL flexible server, Azure Managed Redis and blob storage on private endpoints, workload identities for GitLab and CI jobs, internal DNS records and hub firewall rules. The cluster side (Helm releases and secrets) is in az-gitlab/gitops and reconciled by the cluster Flux.'

targetScope = 'subscription'

import { environmentType, hubReferenceType, lockFor, monitoringReferenceType, tagsType } from '../modules/shared/types.bicep'
import { compactName, regionShortNames } from '../modules/shared/naming.bicep'
import {
  clusterReferenceType
  gitalyType
  gitlabAccessType
  gitlabDnsType
  gitlabPostgresType
  gitlabRedisType
  gitlabRunnersType
  keycloakType
} from 'types.bicep'

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------

@description('Required. Environment.')
param environment environmentType

@description('Required. Region. Must be the cluster region.')
param location string

@description('Optional. Workload name used in resource names.')
param workload string = 'gitlab'

@description('Required. Tags applied to every resource.')
param tags tagsType

@description('Optional. Dedicated (prod default: a separate tools cluster in its own spoke) or Shared (staging default: tainted pools on the application cluster, to save cost). Only changes defaults and the documented trade-offs; the cluster reference decides where GitLab runs.')
param placement ('Dedicated' | 'Shared') = environment == 'prod' ? 'Dedicated' : 'Shared'

@description('Required. Hub connection details (az-landing-zone output "hub"). The private DNS zones and the GitLab zone are in its DNS resource group.')
param hub hubReferenceType

@description('Required. Central monitoring (az-landing-zone output "monitoring").')
param monitoring monitoringReferenceType

@description('Optional. Hub firewall policy (az-landing-zone output firewallPolicyResourceId). When set, client and runner rules are added to it.')
param firewallPolicyResourceId string = ''

@description('Required. The cluster GitLab runs on (az-aks outputs).')
param cluster clusterReferenceType

@description('Required. Host names and internal load balancer addresses.')
param dns gitlabDnsType

@description('Optional. PostgreSQL settings.')
param postgres gitlabPostgresType = {}

@description('Required. PostgreSQL administrator password. Generated by scripts/seed-secrets.sh into the cluster key vault and read with getSecret() in the parameter file.')
@secure()
param postgresAdministratorPassword string

@description('Optional. Managed Redis settings.')
param redis gitlabRedisType = {}

@description('Optional. Gitaly repository storage.')
param gitaly gitalyType = {}

@description('Optional. Who may reach GitLab through the hub firewall.')
param access gitlabAccessType = {}

@description('Optional. CI runner settings.')
param runners gitlabRunnersType = {}

@description('Optional. Keycloak identity broker (off by default).')
param keycloak keycloakType = {}

@description('Conditional. keycloak.enabled: password of the Keycloak database administrator (seeded in the cluster key vault).')
@secure()
param keycloakDatabasePassword string = ''

@description('Optional. Enable AVM usage telemetry.')
param enableTelemetry bool = true

// ---------------------------------------------------------------------------
// Variables
// ---------------------------------------------------------------------------

var isProd = environment == 'prod'
var lock = lockFor(environment)
var baseName = '${workload}-${environment}-${regionShortNames[location]}'
var rgName = '${baseName}-rg'

var clusterSegments = split(cluster.clusterResourceId, '/')
var keyVaultSegments = split(cluster.keyVaultResourceId, '/')
var keyVaultName = last(keyVaultSegments)

var keycloakEnabled = keycloak.?enabled ?? false

var subnets = cluster.subnetResourceIds
var privateEndpointSubnetId = subnets[cluster.?privateEndpointSubnetName ?? 'snet-private-endpoints']

var dnsZoneRg = hub.privateDnsZoneResourceGroupResourceId
var dnsZoneRgSegments = split(dnsZoneRg, '/')
var dnsZone = {
  blob: '${dnsZoneRg}/providers/Microsoft.Network/privateDnsZones/privatelink.blob.${az.environment().suffixes.storage}'
  postgres: '${dnsZoneRg}/providers/Microsoft.Network/privateDnsZones/privatelink.postgres.database.azure.com'
  redis: '${dnsZoneRg}/providers/Microsoft.Network/privateDnsZones/privatelink.redis.azure.net'
}

var hosts = {
  gitlab: dns.?gitlabHost ?? 'gitlab'
  registry: dns.?registryHost ?? 'registry'
  kas: dns.?kasHost ?? 'kas'
  ssh: dns.?sshHost ?? 'ssh'
  keycloak: keycloak.?host ?? 'sso'
}
var gitlabUrl = 'https://${hosts.gitlab}.${dns.zoneName}'

var diagnosticSettings = [
  {
    name: 'to-central-law'
    workspaceResourceId: monitoring.logAnalyticsWorkspaceResourceId
  }
]

var roleIds = {
  storageBlobDataContributor: 'ba92f5b4-2d11-453f-a403-e96b0029c9fe'
  acrPush: '8311e382-0749-4cb8-b61a-304f252e45ec'
}

// Object storage buckets (containers). Names are the chart defaults, so values stay short.
var containers = [
  'gitlab-artifacts'
  'git-lfs'
  'gitlab-uploads'
  'gitlab-packages'
  'gitlab-mr-diffs'
  'gitlab-terraform-state'
  'gitlab-ci-secure-files'
  'gitlab-dependency-proxy'
  'registry'
  'gitlab-backups'
  'tmp'
]

// Guards that can't be expressed in the type.
// Secrets aren't checked here (offline snapshots run without them); the database deployments
// fail on empty values.
var guard = !empty(firewallPolicyResourceId) && !empty(runners.?pushRegistryPrivateEndpointPrefixes ?? []) && empty(runners.?runnerIpGroupResourceId ?? '') && empty(runners.?runnerSubnetPrefix ?? '')
  ? fail('runners.pushRegistryPrivateEndpointPrefixes needs runners.runnerIpGroupResourceId or runners.runnerSubnetPrefix as the rule source.')
  : true

// ---------------------------------------------------------------------------
// Resource group and identities
// ---------------------------------------------------------------------------

module resourceGroup 'br/public:avm/res/resources/resource-group:0.4.4' = if (guard) {
  name: '${uniqueString(deployment().name, location)}-rg'
  params: {
    name: rgName
    location: location
    lock: lock
    tags: tags
    enableTelemetry: enableTelemetry
  }
}

// GitLab (webservice, sidekiq, toolbox, registry) share one service account, federated here.
// It reaches object storage with Entra ID; no storage keys exist.
module gitlabIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = {
  name: '${uniqueString(deployment().name, location)}-id-gitlab'
  scope: az.resourceGroup(rgName)
  params: {
    name: '${baseName}-id-gitlab'
    location: location
    federatedIdentityCredentials: [
      {
        name: 'gitlab'
        issuer: cluster.oidcIssuerUrl
        subject: 'system:serviceaccount:gitlab:gitlab'
        audiences: ['api://AzureADTokenExchange']
      }
    ]
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

// CI jobs run as service account ci-job in namespace ci-jobs and push images with this identity.
module ciIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = {
  name: '${uniqueString(deployment().name, location)}-id-ci'
  scope: az.resourceGroup(rgName)
  params: {
    name: '${baseName}-id-ci'
    location: location
    federatedIdentityCredentials: [
      {
        name: 'ci-job'
        issuer: cluster.oidcIssuerUrl
        subject: 'system:serviceaccount:ci-jobs:ci-job'
        audiences: ['api://AzureADTokenExchange']
      }
    ]
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

var pushRegistries = union([cluster.registryResourceId], runners.?pushRegistryResourceIds ?? [])

module registryPush 'br/public:avm/ptn/authorization/resource-role-assignment:0.1.2' = [
  for (r, i) in pushRegistries: {
    name: '${uniqueString(deployment().name, location)}-ra-acr-${i}'
    scope: az.resourceGroup(split(r, '/')[2], split(r, '/')[4])
    params: {
      resourceId: r
      #disable-next-line what-if-short-circuiting
      principalId: ciIdentity.outputs.principalId
      principalType: 'ServicePrincipal'
      roleDefinitionId: roleIds.acrPush
      enableTelemetry: enableTelemetry
    }
  }
]

// ---------------------------------------------------------------------------
// Object storage
// ---------------------------------------------------------------------------

var storageAccountName = compactName(
  workload,
  environment,
  location,
  'st',
  uniqueString(subscription().id, workload),
  24
)

module storage 'br/public:avm/res/storage/storage-account:0.33.1' = {
  name: '${uniqueString(deployment().name, location)}-st'
  scope: az.resourceGroup(rgName)
  params: {
    name: storageAccountName
    location: location
    kind: 'StorageV2'
    skuName: isProd ? 'Standard_ZRS' : 'Standard_LRS'
    accessTier: 'Hot'
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false
    allowCrossTenantReplication: false
    defaultToOAuthAuthentication: true
    publicNetworkAccess: 'Disabled'
    networkAcls: { bypass: 'AzureServices', defaultAction: 'Deny' }
    blobServices: {
      deleteRetentionPolicyEnabled: true
      deleteRetentionPolicyDays: isProd ? 30 : 7
      containerDeleteRetentionPolicyEnabled: true
      containerDeleteRetentionPolicyDays: isProd ? 30 : 7
      isVersioningEnabled: isProd
      containers: map(containers, c => { name: c, publicAccess: 'None' })
      diagnosticSettings: diagnosticSettings
    }
    // Backup temp files are only needed while a backup or restore runs.
    managementPolicyRules: [
      {
        name: 'expire-tmp'
        enabled: true
        type: 'Lifecycle'
        definition: {
          actions: { baseBlob: { delete: { daysAfterModificationGreaterThan: 2 } } }
          filters: { blobTypes: ['blockBlob'], prefixMatch: ['tmp/'] }
        }
      }
    ]
    privateEndpoints: [
      {
        name: '${storageAccountName}-pe-blob'
        service: 'blob'
        subnetResourceId: privateEndpointSubnetId
        privateDnsZoneGroup: { privateDnsZoneGroupConfigs: [{ privateDnsZoneResourceId: dnsZone.blob }] }
        tags: tags
      }
    ]
    roleAssignments: [
      {
        principalId: gitlabIdentity.outputs.principalId
        principalType: 'ServicePrincipal'
        roleDefinitionIdOrName: subscriptionResourceId(
          'Microsoft.Authorization/roleDefinitions',
          roleIds.storageBlobDataContributor
        )
      }
    ]
    diagnosticSettings: [
      {
        name: 'to-central-law'
        workspaceResourceId: monitoring.logAnalyticsWorkspaceResourceId
        metricCategories: [{ category: 'Transaction' }]
      }
    ]
    lock: lock
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

// ---------------------------------------------------------------------------
// PostgreSQL
// ---------------------------------------------------------------------------

var postgresAdmin = postgres.?administratorLogin ?? 'gitlab'

// GitLab 19 needs amcheck, btree_gist, pg_trgm and plpgsql; pg_stat_statements is recommended.
var postgresExtensions = 'AMCHECK,BTREE_GIST,PG_TRGM,PG_STAT_STATEMENTS'

var postgresEntraAdministrators = map(
  postgres.?entraAdministrators ?? [],
  admin => union(admin, { tenantId: tenant().tenantId })
)

module postgresServer 'br/public:avm/res/db-for-postgre-sql/flexible-server:0.16.1' = {
  name: '${uniqueString(deployment().name, location)}-psql'
  scope: az.resourceGroup(rgName)
  params: {
    name: '${baseName}-psql'
    location: location
    version: postgres.?version ?? '17'
    skuName: postgres.?skuName ?? (isProd ? 'Standard_D4ds_v5' : 'Standard_B2ms')
    tier: postgres.?tier ?? (isProd ? 'GeneralPurpose' : 'Burstable')
    availabilityZone: isProd ? 1 : -1
    highAvailability: postgres.?highAvailability ?? (isProd ? 'ZoneRedundant' : 'Disabled')
    highAvailabilityZone: (postgres.?highAvailability ?? (isProd ? 'ZoneRedundant' : 'Disabled')) == 'ZoneRedundant'
      ? 2
      : -1
    storageSizeGB: postgres.?storageSizeGB ?? 128
    autoGrow: 'Enabled'
    backupRetentionDays: postgres.?backupRetentionDays ?? (isProd ? 35 : 7)
    geoRedundantBackup: isProd ? 'Enabled' : 'Disabled'
    // GitLab authenticates with a password (it has no Entra token support for PostgreSQL).
    // People use Entra ID through postgres.entraAdministrators.
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
      tenantId: tenant().tenantId
    }
    administrators: postgresEntraAdministrators
    administratorLogin: postgresAdmin
    administratorLoginPassword: postgresAdministratorPassword
    publicNetworkAccess: 'Disabled'
    privateEndpoints: [
      {
        name: '${baseName}-psql-pe'
        service: 'postgresqlServer'
        subnetResourceId: privateEndpointSubnetId
        privateDnsZoneGroup: { privateDnsZoneGroupConfigs: [{ privateDnsZoneResourceId: dnsZone.postgres }] }
        tags: tags
      }
    ]
    databases: [
      { name: 'gitlabhq_production', charset: 'UTF8', collation: 'en_US.utf8' }
    ]
    configurations: [
      { name: 'azure.extensions', source: 'user-override', value: postgresExtensions }
      { name: 'require_secure_transport', source: 'user-override', value: 'on' }
    ]
    diagnosticSettings: diagnosticSettings
    lock: lock
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

// ---------------------------------------------------------------------------
// Redis
// ---------------------------------------------------------------------------

// GitLab doesn't support Redis Cluster. EnterpriseCluster presents a single non-clustered
// endpoint to clients (the cluster sits behind a proxy), which is what GitLab expects.
module redisCache 'br/public:avm/res/cache/redis-enterprise:0.5.1' = {
  name: '${uniqueString(deployment().name, location)}-redis'
  scope: az.resourceGroup(rgName)
  params: {
    name: '${baseName}-redis'
    location: location
    skuName: redis.?skuName ?? (isProd ? 'Balanced_B3' : 'Balanced_B0')
    highAvailability: redis.?highAvailability ?? (isProd ? 'Enabled' : 'Disabled')
    minimumTlsVersion: '1.2'
    publicNetworkAccess: 'Disabled'
    database: {
      clientProtocol: 'Encrypted'
      clusteringPolicy: 'EnterpriseCluster'
      evictionPolicy: 'NoEviction'
      // GitLab authenticates with a password; the key goes straight to Key Vault below.
      accessKeysAuthentication: 'Enabled'
      port: 10000
    }
    privateEndpoints: [
      {
        name: '${baseName}-redis-pe'
        service: 'redisEnterprise'
        subnetResourceId: privateEndpointSubnetId
        privateDnsZoneGroup: { privateDnsZoneGroupConfigs: [{ privateDnsZoneResourceId: dnsZone.redis }] }
        tags: tags
      }
    ]
    diagnosticSettings: diagnosticSettings
    lock: lock
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

// The access key never leaves Azure Resource Manager except into Key Vault, where External
// Secrets reads it for the chart.
module redisPasswordSecret 'br/public:avm/res/key-vault/vault/secret:0.1.1' = {
  name: '${uniqueString(deployment().name, location)}-kv-redis'
  scope: az.resourceGroup(keyVaultSegments[2], keyVaultSegments[4])
  params: {
    keyVaultName: keyVaultName
    name: 'gitlab-redis-password'
    value: redisCache.outputs.?primaryAccessKey ?? ''
    contentType: 'Azure Managed Redis access key for GitLab'
    enableTelemetry: enableTelemetry
  }
}

// ---------------------------------------------------------------------------
// Keycloak (optional)
// ---------------------------------------------------------------------------

var keycloakHa = keycloak.?highAvailability ?? isProd

module keycloakDatabase 'br/public:avm/res/db-for-postgre-sql/flexible-server:0.16.1' = if (keycloakEnabled) {
  name: '${uniqueString(deployment().name, location)}-psql-kc'
  scope: az.resourceGroup(rgName)
  params: {
    name: '${baseName}-psql-keycloak'
    location: location
    version: '17'
    skuName: keycloakHa ? 'Standard_D2ds_v5' : 'Standard_B1ms'
    tier: keycloakHa ? 'GeneralPurpose' : 'Burstable'
    availabilityZone: keycloakHa ? 1 : -1
    highAvailability: keycloakHa ? 'ZoneRedundant' : 'Disabled'
    highAvailabilityZone: keycloakHa ? 2 : -1
    storageSizeGB: 32
    backupRetentionDays: isProd ? 35 : 7
    geoRedundantBackup: isProd ? 'Enabled' : 'Disabled'
    authConfig: {
      activeDirectoryAuth: 'Enabled'
      passwordAuth: 'Enabled'
      tenantId: tenant().tenantId
    }
    administrators: postgresEntraAdministrators
    administratorLogin: 'keycloak'
    administratorLoginPassword: keycloakDatabasePassword
    publicNetworkAccess: 'Disabled'
    privateEndpoints: [
      {
        name: '${baseName}-psql-keycloak-pe'
        service: 'postgresqlServer'
        subnetResourceId: privateEndpointSubnetId
        privateDnsZoneGroup: { privateDnsZoneGroupConfigs: [{ privateDnsZoneResourceId: dnsZone.postgres }] }
        tags: tags
      }
    ]
    databases: [{ name: 'keycloak', charset: 'UTF8', collation: 'en_US.utf8' }]
    configurations: [{ name: 'require_secure_transport', source: 'user-override', value: 'on' }]
    diagnosticSettings: diagnosticSettings
    lock: lock
    tags: tags
    enableTelemetry: enableTelemetry
  }
  dependsOn: [resourceGroup]
}

// ---------------------------------------------------------------------------
// DNS: records in the hub-linked GitLab zone, resolved through the firewall DNS proxy
// ---------------------------------------------------------------------------

var records = concat(
  [
    { name: hosts.gitlab, ip: dns.ingressIp }
    { name: hosts.registry, ip: dns.ingressIp }
    { name: hosts.kas, ip: dns.ingressIp }
    { name: hosts.ssh, ip: dns.sshIp }
  ],
  keycloakEnabled ? [{ name: hosts.keycloak, ip: dns.ingressIp }] : []
)

module dnsRecords 'br/public:avm/res/network/private-dns-zone/a:0.1.0' = [
  for r in records: {
    name: '${uniqueString(deployment().name, location)}-dns-${r.name}'
    scope: az.resourceGroup(dnsZoneRgSegments[2], dnsZoneRgSegments[4])
    params: {
      privateDnsZoneName: dns.zoneName
      name: r.name
      ttl: 300
      aRecords: [{ ipv4Address: r.ip }]
      enableTelemetry: enableTelemetry
    }
  }
]

// ---------------------------------------------------------------------------
// Hub firewall: clients to GitLab, runners to push registries
// ---------------------------------------------------------------------------

var firewallPolicySegments = split(firewallPolicyResourceId, '/')
var clientIpGroups = access.?clientIpGroupResourceIds ?? []
var clientPrefixes = access.?clientAddressPrefixes ?? []
var hasClients = !empty(clientIpGroups) || !empty(clientPrefixes)
var runnerSource = !empty(runners.?runnerIpGroupResourceId ?? '')
  ? { sourceIpGroups: [runners.?runnerIpGroupResourceId] }
  : { sourceAddresses: empty(runners.?runnerSubnetPrefix ?? '') ? [] : [runners.?runnerSubnetPrefix] }
var pushPrefixes = runners.?pushRegistryPrivateEndpointPrefixes ?? []

module firewallRules '../modules/network/firewall-rule-collection-group/main.bicep' = if (!empty(firewallPolicyResourceId)) {
  name: '${uniqueString(deployment().name, location)}-afw-rules'
  scope: az.resourceGroup(firewallPolicySegments[2], firewallPolicySegments[4])
  params: {
    firewallPolicyName: last(firewallPolicySegments)
    name: '${baseName}-rcg'
    priority: access.?firewallRulePriority ?? 1160
    ruleCollections: hasClients || !empty(pushPrefixes)
      ? [
          {
            name: 'gitlab-network'
            ruleCollectionType: 'FirewallPolicyFilterRuleCollection'
            priority: 100
            action: { type: 'Allow' }
            rules: concat(
              hasClients
                ? [
                    {
                      ruleType: 'NetworkRule'
                      name: 'clients-to-gitlab'
                      ipProtocols: ['TCP']
                      sourceIpGroups: clientIpGroups
                      sourceAddresses: clientPrefixes
                      destinationAddresses: [dns.ingressIp, dns.sshIp]
                      destinationPorts: ['443', '22']
                    }
                  ]
                : [],
              !empty(pushPrefixes)
                ? [
                    {
                      ruleType: 'NetworkRule'
                      name: 'runners-to-push-registries'
                      ipProtocols: ['TCP']
                      ...runnerSource
                      destinationAddresses: pushPrefixes
                      destinationPorts: ['443']
                    }
                  ]
                : []
            )
          }
        ]
      : []
  }
}

// ---------------------------------------------------------------------------
// Outputs (no secrets)
// ---------------------------------------------------------------------------

@description('Placement used for defaults (Dedicated or Shared).')
output placement string = placement

@description('Resource group of the GitLab data services.')
output resourceGroupName string = rgName

@description('Client ID of the GitLab workload identity (service account gitlab/gitlab).')
output gitlabClientId string = gitlabIdentity.outputs.clientId

@description('Client ID of the CI job identity (service account ci-jobs/ci-job).')
output ciClientId string = ciIdentity.outputs.clientId

@description('Storage account for object storage and backups.')
output storageAccountName string = storage.outputs.name

@description('PostgreSQL host name.')
output postgresHost string = postgresServer.outputs.?fqdn ?? ''

@description('PostgreSQL user GitLab connects as.')
output postgresUser string = postgresAdmin

@description('Redis host name (TLS, port 10000).')
output redisHost string = redisCache.outputs.hostName

@description('Keycloak database host, empty when Keycloak is off.')
output keycloakDatabaseHost string = keycloakEnabled ? keycloakDatabase!.outputs.?fqdn ?? '' : ''

@description('GitLab URL.')
output gitlabUrl string = gitlabUrl

@description('Cluster resource group (where the Kubernetes side runs).')
output clusterResourceGroupName string = clusterSegments[4]

@description('Non-secret values for the gitlab-settings ConfigMap that Flux substitutes into az-gitlab/gitops (scripts/write-gitlab-settings.sh). The chart uses the default host labels (gitlab, registry, kas, ssh).')
output gitlabSettings object = {
  GITLAB_DOMAIN: dns.zoneName
  GITLAB_INGRESS_IP: dns.ingressIp
  GITLAB_SSH_IP: dns.sshIp
  GITLAB_CLIENT_ID: gitlabIdentity.outputs.clientId
  CI_CLIENT_ID: ciIdentity.outputs.clientId
  POSTGRES_HOST: postgresServer.outputs.?fqdn ?? ''
  POSTGRES_USER: postgresAdmin
  REDIS_HOST: redisCache.outputs.hostName
  STORAGE_ACCOUNT: storage.outputs.name
  STORAGE_DOMAIN: 'blob.${az.environment().suffixes.storage}'
  STORAGE_REALM: az.environment().suffixes.storage
  GITALY_DISK_SIZE: '${gitaly.?diskSizeGB ?? (isProd ? 256 : 64)}Gi'
  BACKUP_SCHEDULE: isProd ? '0 2 * * *' : '0 3 * * 0'
  RUNNER_CONCURRENT: isProd ? '20' : '4'
  KEYCLOAK_HOST: hosts.keycloak
  KEYCLOAK_DB_HOST: keycloakEnabled ? keycloakDatabase!.outputs.?fqdn ?? '' : ''
  KEYCLOAK_REPLICAS: keycloakHa ? '2' : '1'
}
